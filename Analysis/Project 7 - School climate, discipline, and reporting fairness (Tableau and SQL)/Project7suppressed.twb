      <aliases enabled='yes' />
      <column caption='Survey result display' datatype='string' name='[Calculation_1423103983431680]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([reporting_status]) = &quot;Suppressed&quot; THEN&#13;&#10;    &quot;Suppressed&quot;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(MIN([favorable_response_pct]), 1))&#13;&#10;    + &quot;% favorable | Valid responses: &quot;&#13;&#10;    + STR(INT(MIN([valid_item_responses])))&#13;&#10;END' />
      </column>
