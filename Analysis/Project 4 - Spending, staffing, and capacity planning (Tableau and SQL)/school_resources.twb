      <aliases enabled='yes' />
      <column caption='Budget Status' datatype='string' name='[Calculation_1653449565454336]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([budget_variance]) &gt; 0 THEN&#13;&#10;    &quot;Over budget — unfavorable&quot;&#13;&#10;ELSEIF SUM([budget_variance]) &lt; 0 THEN&#13;&#10;    &quot;Under budget — favorable&quot;&#13;&#10;ELSE&#13;&#10;    &quot;On budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Chart Spending per Student' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_1653449591558145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual])/SUM([enrollment])' />
      </column>
      <column caption='Chart Students per Teacher FTE' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1653449591992322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([enrollment]) / SUM([teacher_fte])' />
      </column>
