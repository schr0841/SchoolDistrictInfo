      <aliases enabled='yes' />
      <column aggregation='None' caption='Absent Days (bin)' datatype='integer' name='[Absent Days (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[absent_days]' peg='0' size='5' />
      </column>
      <column caption='Students' datatype='integer' name='[Calculation_2083081964617728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([student_id])' />
      </column>
      <column caption='Overall Attendance Rate' datatype='real' default-format='p0.0%' name='[Calculation_2083081965846529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([present_days])/SUM([membership_days])' />
      </column>
      <column caption='Student Annual Absence Rate' datatype='real' default-format='p0.0%' name='[Calculation_2083082034081794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [membership_days] &gt;0 THEN&#13;&#10;    FLOAT([absent_days])/[membership_days]&#13;&#10;END' />
      </column>
      <column caption='Chronic Absence Flag' datatype='integer' name='[Calculation_2083082035974147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_2083082034081794]) THEN&#13;&#10;NULL&#13;&#10;ELSEIF [Calculation_2083082034081794]&gt;= 0.10 THEN&#13;&#10;1&#13;&#10;ELSE &#13;&#10;0&#13;&#10;END' />
      </column>
      <column caption='Chronic Absence Rate' datatype='real' default-format='p0.0%' name='[Calculation_2083082042847236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2083082035974147])/COUNT([Calculation_2083082035974147])' />
      </column>
