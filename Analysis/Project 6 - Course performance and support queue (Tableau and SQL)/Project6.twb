      <aliases enabled='yes' />
      <column caption='Eligible Students' datatype='integer' name='[Calculation_1143552183701504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([student_alias])' />
      </column>
      <column caption='Review Candidates' datatype='integer' name='[Calculation_1143552183832577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [review_status] =&#13;&#10;        &quot;Hypothetical counselor review candidate&quot;&#13;&#10;    THEN [student_alias]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Candidate Share' datatype='real' name='[Calculation_1143552183922690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1143552183701504] &gt; 0 THEN&#13;&#10;    [Calculation_1143552183832577] / [Calculation_1143552183701504]&#13;&#10;END' />
      </column>
      <column caption='Unresolved Selection' datatype='integer' name='[Calculation_1143552184045571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [review_status] =&#13;&#10;        &quot;Data review needed; selection unresolved&quot;&#13;&#10;    THEN [student_alias]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Eligible Students in Grade' datatype='integer' name='[Calculation_1143552211324932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [school_year], [grade_level] :&#13;&#10;    COUNTD([student_alias])&#13;&#10;}' />
      </column>
