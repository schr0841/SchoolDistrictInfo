      <aliases enabled='yes' />
      <column caption='Participation Rate' datatype='real' default-format='p0.0%' name='[Calculation_1728490523033600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_tests])/SUM([expected_tests])' />
      </column>
      <column caption='Missing Score Rate' datatype='real' default-format='p0.0%' name='[Calculation_1728490523332609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([without_valid_score])/SUM([expected_tests])' />
      </column>
      <column caption='Proficiency Rate' datatype='real' default-format='p0.0%' name='[Calculation_1728490533564419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([valid_tests]) &gt; 0 THEN&#13;&#10;    SUM([proficient_students]) / SUM([valid_tests])&#13;&#10;END' />
      </column>
