  <worksheets>
    <worksheet name='Attendance Comparison'>
      <table>
        <view>
          <datasources>
            <datasource caption='Project5_Tableau_Student_Year' name='federated.0rvcuou1cpw2pl1fjzxsi0p5cmt9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Program to Review' datatype='string' name='[Parameter 0830190968479744]' param-domain-type='list' role='measure' type='nominal' value='&quot;Math tutoring&quot;'>
              <calculation class='tableau' formula='&quot;Math tutoring&quot;' />
            </column>
            <column caption='Subject to Review' datatype='string' name='[Parameter 0830190969257985]' param-domain-type='list' role='measure' type='nominal' value='&quot;Math&quot;'>
              <calculation class='tableau' formula='&quot;Math&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rvcuou1cpw2pl1fjzxsi0p5cmt9'>
            <column datatype='integer' name='[Assessment Eligible Flag]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Attended Sessions]' role='measure' type='quantitative' />
            <column caption='Selected Program' datatype='boolean' name='[Calculation_0830190972178435]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Program], &quot;&quot;) = [Parameters].[Parameter 0830190968479744]' />
            </column>
            <column caption='Program Reach' datatype='real' default-format='p0.00%' name='[Calculation_0830190972432389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0830190972178435] THEN 1 ELSE 0 END)&#13;&#10;/ COUNTD([Student ID])' />
            </column>
            <column caption='Session Completion' datatype='real' default-format='p0.00%' name='[Calculation_0830190972751878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Planned Sessions]) &gt; 0 THEN&#13;&#10;    SUM([Attended Sessions]) / SUM([Planned Sessions])&#13;&#10;END' />
            </column>
            <column caption='Cost per Attended Session' datatype='real' default-format='C1033%' name='[Calculation_0830190972866567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Attended Sessions]) &gt; 0 THEN&#13;&#10;    SUM([Intervention Cost]) / SUM([Attended Sessions])&#13;&#10;END' />
            </column>
            <column caption='Participants Without Baseline' datatype='integer' name='[Calculation_0830190973181961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Prior Baseline Flag] = 0 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Comparison Group' datatype='string' name='[Calculation_0830190973308938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0830190972178435] THEN &quot;Recorded participant&quot;&#13;&#10;ELSEIF ISNULL([Program]) OR [Program] = &quot;&quot; THEN &quot;No recorded intervention&quot;&#13;&#10;ELSE &quot;Other program — exclude from comparison&quot;&#13;&#10;END' />
            </column>
            <column caption='Selected Growth' datatype='integer' name='[Calculation_0830190973562891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0830190969257985]&#13;&#10;WHEN &quot;Math&quot; THEN [Math Growth Points]&#13;&#10;WHEN &quot;Reading&quot; THEN [Reading Growth Points]&#13;&#10;END' />
            </column>
            <column caption='Paired Students' datatype='integer' name='[Calculation_0830190973997069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Assessment Eligible Flag] = 1&#13;&#10;AND NOT ISNULL([Calculation_0830190973562891]) THEN [Student ID] END)' />
            </column>
            <column caption='Comparable Attendance' datatype='boolean' name='[Calculation_0830190974226446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Prior Baseline Flag] = 1&#13;&#10;AND [Membership Days] &gt; 0&#13;&#10;AND NOT ISNULL([Present Days])' />
            </column>
            <column caption='Baseline Attendance Rate' datatype='real' default-format='p0.00%' name='[Calculation_0830190975561744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0830190974226446] THEN&#13;&#10;    [Prior Membership Days] - [Prior Absent Days] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_0830190974226446] THEN [Prior Membership Days] END)' />
            </column>
            <column caption='Comparable Current Attendance Rate' datatype='real' default-format='p0.00%' name='[Calculation_0830190976040977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0830190974226446] THEN [Present Days] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_0830190974226446] THEN [Membership Days] END)' />
            </column>
            <column caption='Attendance Change PP' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0830190976196626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * ([Calculation_0830190976040977] - [Calculation_0830190975561744])' />
            </column>
            <column caption='Comparable Attendance Students' datatype='integer' name='[Calculation_0830190976393235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_0830190974226446] THEN [Student ID] END)' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Grade Level]' role='dimension' type='ordinal' />
